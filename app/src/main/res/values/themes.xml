<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Starcord" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Status bar matches app background -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg</item>
        <!-- Nav bar matches bottom panel -->
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface</item>

        <!-- Material color roles -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
